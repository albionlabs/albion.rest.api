RUST_LOG=albion_rest_api=info,rocket=warn,warn

# Credentialed RPC endpoints referenced by the [additional_rpcs] config table
# via ${VAR} placeholders. On prod/staging these are supplied by
# EnvironmentFile=/etc/albion/<name>.env. Any URL whose var is unset is dropped
# at startup with a warning, so these are optional for local dev.
DRPC_API_KEY=
ALCHEMY_API_KEY=
